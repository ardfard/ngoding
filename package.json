{
  "name": "ngoding",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm run build:editor",
    "build:editor": "esbuild editor/codemirror.js --bundle --format=esm --minify --legal-comments=eof --outfile=public/codemirror.js",
    "build:image": "./image/build.sh",
    "start": "cargo run --release",
    "test": "cargo test",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "codemirror": "^6.0.2",
    "ghostty-web": "^0.4.0",
    "v86": "^0.5.472"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1"
  }
}
