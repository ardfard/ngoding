                                  "name": "G",
                                  "fill": "#3d4635",
                                  "content": "03",
                                  "fontFamily": "$fontMono",
                                  "fontSize": 11,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "aZYxm",
                                  "name": "C",
                                  "fill": "$fg",
                                  "content": "    for i, x in enumerate(nums):",
                                  "fontFamily": "$fontMono",
                                  "fontSize": 11,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "yuQZW",
                              "name": "L04",
                              "width": "fill_container",
                              "gap": 10,
                              "children": [
