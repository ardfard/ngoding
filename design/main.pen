                                  "content": "02",
                                  "fontFamily": "$fontMono",
                                  "fontSize": 11,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "v4Udhm",
                                  "name": "C",
                                  "fill": "$fg",
                                  "content": "    hashmap = {}",
                                  "fontFamily": "$fontMono",
                                  "fontSize": 11,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
