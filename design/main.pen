                                  "name": "G",
                                  "fill": "#3d4635",
                                  "content": "04",
                                  "fontFamily": "$fontMono",
                                  "fontSize": 11,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "pQ7f3",
                                  "name": "C",
                                  "fill": "$fg",
                                  "content": "        need = target - x",
                                  "fontFamily": "$fontMono",
                                  "fontSize": 11,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
