                                  "type": "text",
                                  "id": "ixdR4",
                                  "name": "C",
                                  "fill": "$fg",
                                  "content": "        if need in hashmap:",
                                  "fontFamily": "$fontMono",
                                  "fontSize": 11,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
